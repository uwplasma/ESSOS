vacuum	'OPTIMIZE = False' 'CASE = "qa_vacuum"' 'VMEX_ROUTES = ("direct",)' 'TRACE_FIELD_LINES = False'
axisym	'OPTIMIZE = False' 'CASE = "axisymmetric"' 'VMEX_ROUTES = ("direct",)'
